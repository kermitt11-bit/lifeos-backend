# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     # required for /cron/* jobs
SUPABASE_JWT_SECRET=                         # optional; if set, JWTs are verified locally (HS256)

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Embeddings (Voyage AI) ---
# /api/ingest and /api/chat degrade gracefully to keyword-only when blank.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Cron ---
CRON_SECRET=change-me-long-random

# --- Server ---
PORT=3000
