{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ],
  "crons": [
    { "path": "/cron/daily-summary?secret=$CRON_SECRET", "schedule": "0 11 * * *" },
    { "path": "/cron/weekly-review?secret=$CRON_SECRET", "schedule": "0 14 * * 1" }
  ]
}
